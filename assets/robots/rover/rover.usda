#usda 1.0
(
    defaultPrim = "rover"
    doc = "Inspection rover. 4WD skid-steer, lidar + barcode scanner. ArticulationRootAPI is on the payload root prim."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "rover" (
    kind = "component"
    prepend payload = @./rover_geom.usdc@</rover>
)
{
    float3[] extentsHint = [(-0.35, -0.33, 0), (0.35, 0.33, 0.5)]
}

