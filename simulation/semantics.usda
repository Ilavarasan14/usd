#usda 1.0
(
    doc = "SDG labels for Isaac Sim 6.0: UsdSemantics.LabelsAPI, taxonomy 'class'. The legacy Semantics.SemanticsAPI (semanticType/semanticData) is deprecated in 6.0 -- see isaacsim.core.utils.semantics.upgrade_prim_semantics_to_labels. `over` prims only; nothing is defined here."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    over "Environment"
    {
        over "Shell"
        {
            over "floor_slab" (
                prepend apiSchemas = ["SemanticsLabelsAPI:class"]
