#usda 1.0
(
    doc = "Visual materials. Each carries BOTH an MDL surface (OmniPBR -- what the RTX renderer consumes) and a UsdPreviewSurface, so the stage still shades correctly when opened outside Omniverse."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "concrete_floor"
        {
            token outputs:mdl:displacement.connect = </World/Looks/concrete_floor/mdl_shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/concrete_floor/mdl_shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/concrete_floor/mdl_shader.outputs:out>
            token outputs:surface.connect = </World/Looks/concrete_floor/preview_shader.outputs:surface>

            def Shader "mdl_shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.42, 0.42, 0.44)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.55
                token outputs:out
            }

            def Shader "preview_shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.42, 0.44)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "wall_panel"
        {
            token outputs:mdl:displacement.connect = </World/Looks/wall_panel/mdl_shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/wall_panel/mdl_shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/wall_panel/mdl_shader.outputs:out>
            token outputs:surface.connect = </World/Looks/wall_panel/preview_shader.outputs:surface>

