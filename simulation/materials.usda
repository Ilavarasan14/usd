    over "Environment"
    {
        over "Shell"
        {
            over "floor_slab" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/Looks/concrete_floor> (
                    bindMaterialAs = "weakerThanDescendants"
                )
