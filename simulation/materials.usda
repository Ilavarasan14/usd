                float inputs:reflection_roughness_constant = 0.75
                token outputs:out
            }

            def Shader "preview_shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.71, 0.68)
                float inputs:metallic = 0
