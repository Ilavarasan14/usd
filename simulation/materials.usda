            token outputs:mdl:displacement.connect = </World/Looks/amr_rubber/mdl_shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/amr_rubber/mdl_shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/amr_rubber/mdl_shader.outputs:out>
            token outputs:surface.connect = </World/Looks/amr_rubber/preview_shader.outputs:surface>

            def Shader "mdl_shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.05, 0.05, 0.05)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.85
                token outputs:out
            }

            def Shader "preview_shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

