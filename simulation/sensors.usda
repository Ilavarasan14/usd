#usda 1.0
(
    doc = "Cameras. RTX Lidar and IMU prims are NOT authored here -- see the note attribute on each mount."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def "Scenario"
    {
        def "Fleet"
        {
            def "amr_tote_01"
            {
                def "Sensors"
                {
                    def "camera_mount"
                    {
                        def Camera "rgb"
                        {
                            float2 clippingRange = (0.105, 10)
                            float focalLength = 1.88
                            float horizontalAperture = 2.604
                            token projection = "perspective"
                            float verticalAperture = 1.4648
                            quatd xformOp:orient = (1, 0, 0, 0)
                            double3 xformOp:translate = (0, 0, 0)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                        }
                    }

                    def "lidar_mount"
                    {
                        custom string isaac:note = "RTX Lidar obstacle detector. Isaac Sim creates ray returns under this prim; controller should stop and re-route on a near return. Mount pose: (0.42, 0, 0.20) m in robot frame, +X forward."

                        def IsaacRtxLidar "obstacle_lidar"
                        {
                            float inputs:horizontalFov = 275
                            uint inputs:horizontalResolution = 1024
                            float inputs:range = 12
                            float inputs:verticalFov = 30
                            uint inputs:verticalResolution = 8
                            bool isaac:obstacleDetection = 1
                            token sensor:type = "raycast"
                        }
                    }

                    over "imu_mount"
                    {
                        custom string isaac:note = "IMU not authored offline -- isaacsim.sensors.physics is a Kit extension. Mount pose is final: (0, 0, 0.24) m, coincident with the chassis body origin."
                    }
                }
            }

            def "amr_tote_02"
            {
                def "Sensors"
                {
                    def "camera_mount"
                    {
                        def Camera "rgb"
                        {
                            float2 clippingRange = (0.105, 10)
                            float focalLength = 1.88
                            float horizontalAperture = 2.604
                            token projection = "perspective"
                            float verticalAperture = 1.4648
                            quatd xformOp:orient = (1, 0, 0, 0)
                            double3 xformOp:translate = (0, 0, 0)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                        }
                    }

                    def "lidar_mount"
                    {
                        custom string isaac:note = "RTX Lidar obstacle detector. Isaac Sim creates ray returns under this prim; controller should stop and re-route on a near return. Mount pose: (0.42, 0, 0.20) m in robot frame, +X forward."

                        def IsaacRtxLidar "obstacle_lidar"
                        {
                            float inputs:horizontalFov = 275
                            uint inputs:horizontalResolution = 1024
                            float inputs:range = 12
                            float inputs:verticalFov = 30
                            uint inputs:verticalResolution = 8
                            bool isaac:obstacleDetection = 1
                            token sensor:type = "raycast"
                        }
                    }

                    over "imu_mount"
                    {
                        custom string isaac:note = "IMU not authored offline -- isaacsim.sensors.physics is a Kit extension. Mount pose is final: (0, 0, 0.24) m, coincident with the chassis body origin."
                    }
                }
            }

