                        }
                    }

                    def "lidar_mount"
                    {
                        custom string isaac:note = "RTX Lidar obstacle detector. Isaac Sim creates ray returns under this prim; controller should stop and re-route on a near return. Mount pose: (0.42, 0, 0.20) m in robot frame, +X forward."

