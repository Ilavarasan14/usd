#usda 1.0
(
    doc = "Cameras. RTX Lidar and IMU prims are NOT authored here -- see the note attribute on each mount."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def "Scenario"
    {
        def "Fleet"
        {
            def "amr_tote_01"
            {
                def "Sensors"
                {
                    def "camera_mount"
                    {
                        def Camera "rgb"
                        {
                            float2 clippingRange = (0.105, 10)
                            float focalLength = 1.88
                            float horizontalAperture = 2.604
                            token projection = "perspective"
                            float verticalAperture = 1.4648
                            quatd xformOp:orient = (1, 0, 0, 0)
                            double3 xformOp:translate = (0, 0, 0)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                        }
                    }

                    over "lidar_mount"
                    {
                        custom string isaac:note = "RTX Lidar not authored offline. Create in Kit under this prim. Mount pose is final: (0.42, 0, 0.20) m in robot frame, +X forward. Modelled sensor: SICK nanoScan3, 275 deg aperture, scan plane at 0.20 m AGL."
                    }

                    over "imu_mount"
                    {
                        custom string isaac:note = "IMU not authored offline -- isaacsim.sensors.physics is a Kit extension. Mount pose is final: (0, 0, 0.24) m, coincident with the chassis body origin."
                    }
                }
            }

            def "amr_tote_02"
            {
                def "Sensors"
                {
                    def "camera_mount"
                    {
                        def Camera "rgb"
                        {
                            float2 clippingRange = (0.105, 10)
                            float focalLength = 1.88
                            float horizontalAperture = 2.604
                            token projection = "perspective"
                            float verticalAperture = 1.4648
                            quatd xformOp:orient = (1, 0, 0, 0)
                            double3 xformOp:translate = (0, 0, 0)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                        }
                    }

                    over "lidar_mount"
                    {
                        custom string isaac:note = "RTX Lidar not authored offline. Create in Kit under this prim. Mount pose is final: (0.42, 0, 0.20) m in robot frame, +X forward. Modelled sensor: SICK nanoScan3, 275 deg aperture, scan plane at 0.20 m AGL."
                    }

                    over "imu_mount"
                    {
                        custom string isaac:note = "IMU not authored offline -- isaacsim.sensors.physics is a Kit extension. Mount pose is final: (0, 0, 0.24) m, coincident with the chassis body origin."
                    }
                }
            }

            def "amr_tote_03"
            {
                def "Sensors"
                {
                    def "camera_mount"
                    {
                        def Camera "rgb"
                        {
                            float2 clippingRange = (0.105, 10)
                            float focalLength = 1.88
                            float horizontalAperture = 2.604
                            token projection = "perspective"
                            float verticalAperture = 1.4648
                            quatd xformOp:orient = (1, 0, 0, 0)
                            double3 xformOp:translate = (0, 0, 0)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                        }
                    }

                    over "lidar_mount"
                    {
                        custom string isaac:note = "RTX Lidar not authored offline. Create in Kit under this prim. Mount pose is final: (0.42, 0, 0.20) m in robot frame, +X forward. Modelled sensor: SICK nanoScan3, 275 deg aperture, scan plane at 0.20 m AGL."
                    }

                    over "imu_mount"
                    {
                        custom string isaac:note = "IMU not authored offline -- isaacsim.sensors.physics is a Kit extension. Mount pose is final: (0, 0, 0.24) m, coincident with the chassis body origin."
                    }
                }
            }

            def "amr_tote_04"
            {
                def "Sensors"
                {
                    def "camera_mount"
                    {
                        def Camera "rgb"
                        {
                            float2 clippingRange = (0.105, 10)
                            float focalLength = 1.88
                            float horizontalAperture = 2.604
                            token projection = "perspective"
                            float verticalAperture = 1.4648
                            quatd xformOp:orient = (1, 0, 0, 0)
                            double3 xformOp:translate = (0, 0, 0)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                        }
                    }

                    over "lidar_mount"
                    {
                        custom string isaac:note = "RTX Lidar not authored offline. Create in Kit under this prim. Mount pose is final: (0.42, 0, 0.20) m in robot frame, +X forward. Modelled sensor: SICK nanoScan3, 275 deg aperture, scan plane at 0.20 m AGL."
                    }

                    over "imu_mount"
                    {
                        custom string isaac:note = "IMU not authored offline -- isaacsim.sensors.physics is a Kit extension. Mount pose is final: (0, 0, 0.24) m, coincident with the chassis body origin."
                    }
                }
            }

            def "rover_01"
            {
                def "tilt_head"
                {
                    def "camera_mount"
                    {
                        def Camera "pov"
                        {
                            float2 clippingRange = (0.05, 40)
                            float focalLength = 2.8
                            float horizontalAperture = 5.6
                            custom string isaac:note = "Rover first-person view. Select this prim as the active viewport camera, or bind it to a Replicator render product. Aimed by joint_pan (Z, +/-175 deg) and joint_tilt (Y, +/-45 deg)."
                            token projection = "perspective"
                            float verticalAperture = 3.15
                            quatd xformOp:orient = (1, 0, 0, 0)
                            double3 xformOp:translate = (0, 0, 0)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                        }
                    }
                }

                def "ViewCameras"
                {
                    def Camera "chase"
                    {
                        float2 clippingRange = (0.1, 80)
                        float focalLength = 24
                        float horizontalAperture = 36
                        custom string isaac:note = "Chase view. Parented to the rover root, so it FOLLOWS the robot. Rear-left 3/4 on a 1.25 m boom -- short enough to stay clear of racking while the rover turns in place."
                        token projection = "perspective"
                        float verticalAperture = 20.25
                        quatd xformOp:orient = (0.7100888911353935, 0.3421134010884018, -0.2671140718845947, -0.5544206526483884)
                        double3 xformOp:translate = (-1.2, -0.35, 1.85)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                    }

                    def Camera "chase_top"
                    {
                        float2 clippingRange = (0.5, 40)
                        float focalLength = 35
                        float horizontalAperture = 36
                        custom string isaac:note = "Overhead follow, 6 m above the rover, image-up = robot forward. Zero boom radius, so it never clips racking regardless of heading."
                        token projection = "perspective"
                        float verticalAperture = 20.25
                        quatd xformOp:orient = (-0.7071067811865475, 0, 0, 0.7071067811865476)
                        double3 xformOp:translate = (0, 0, 6)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                    }
                }
            }
        }
    }

    def Scope "Simulation"
    {
        def Scope "ViewCameras"
        {
            def Camera "rover_aisle"
            {
                float2 clippingRange = (0.1, 80)
                float focalLength = 35
                float horizontalAperture = 36
                custom string isaac:note = "Third-person view of rover_01. Static, world-space. 35 mm equivalent. Both eye and target sit inside the 3.2 m aisle, so nothing clips through racking."
                token projection = "perspective"
                float verticalAperture = 20.25
                quatd xformOp:orient = (0.5749084791177166, 0.47972904396250665, 0.42466537298831714, 0.5089200389079475)
                double3 xformOp:translate = (1, -1.1, 2.3)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Camera "rover_closeup"
            {
                float2 clippingRange = (0.1, 80)
                float focalLength = 50
                float horizontalAperture = 36
                custom string isaac:note = "Third-person view of rover_01. Static, world-space. 50 mm equivalent. Both eye and target sit inside the 3.2 m aisle, so nothing clips through racking."
                token projection = "perspective"
                float verticalAperture = 20.25
                quatd xformOp:orient = (0.6606075194329784, 0.4859326368789148, 0.3390808122937143, 0.4609678735212971)
                double3 xformOp:translate = (-4.6, -1.25, 1.75)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }

        def Scope "FixedCameras"
        {
            def Camera "ceiling_00"
            {
                float2 clippingRange = (0.5, 30)
                float focalLength = 6
                float horizontalAperture = 7.18
                token projection = "perspective"
                float verticalAperture = 5.32
                quatd xformOp:orient = (6.123233995736766e-17, 1, 0, 0)
                double3 xformOp:translate = (0, -5.9, 10.1)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Camera "ceiling_01"
            {
                float2 clippingRange = (0.5, 30)
                float focalLength = 6
                float horizontalAperture = 7.18
                token projection = "perspective"
                float verticalAperture = 5.32
                quatd xformOp:orient = (6.123233995736766e-17, 1, 0, 0)
                double3 xformOp:translate = (0, 0, 10.1)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Camera "ceiling_02"
            {
                float2 clippingRange = (0.5, 30)
                float focalLength = 6
                float horizontalAperture = 7.18
                token projection = "perspective"
                float verticalAperture = 5.32
                quatd xformOp:orient = (6.123233995736766e-17, 1, 0, 0)
                double3 xformOp:translate = (0, 5.9, 10.1)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }
    }
}

