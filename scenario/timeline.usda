                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                }
            }
        }

        def Scope "Timeline"
        {
            custom double mission:durationSeconds = 362.83333333333337
            custom string[] mission:tasks = ["rover_01: closed patrol loop, 14 legs, 363.3 m, 362.8 s at 1.2 m/s (0.6 m/s in cross-aisle)", "amr_tote_01: pick_drop_west -> dock_east_c", "amr_tote_02: dock_east_a -> pick_drop_west", "amr_tote_03: charge_02 -> dock_east_d"]
            custom double mission:tourDistanceMeters = 363.30000000000007
        }
    }
}

