#usda 1.0
(
    doc = """Warehouse bay for AMR navigation. Isaac Sim 6.0.1 / Kit 110.1.2.
             Composition only -- this layer defines no prims.
             Bay extent 60 x 24 m, clear height 10.5 m. Z-up, meters, kilograms."""

    defaultPrim = "World"
    metersPerUnit = 1.0
    kilogramsPerUnit = 1.0
    upAxis = "Z"
    timeCodesPerSecond = 60
    startTimeCode = 0
    endTimeCode = 1800

    subLayers = [
        @./safety/overrides.usda@,                  # STRONGEST -- corrections win over everything
        @./safety/constraints.usda@,
        @./lighting/artificial_lights.usda@,
        @./lighting/sky.usda@,
        @./lighting/sun.usda@,
        @./simulation/semantics.usda@,
        @./simulation/sensors.usda@,
        @./simulation/materials.usda@,
        @./simulation/physics.usda@,
        @./scenario/timeline.usda@,
        @./scenario/routes.usda@,
        @./scenario/placements.usda@,
        @./environment/infrastructure.usdc@,
        @./environment/racking.usdc@,
        @./environment/shell.usdc@                  # WEAKEST -- floor slab, walls, roof
    ]
)

over "World"
{
}
